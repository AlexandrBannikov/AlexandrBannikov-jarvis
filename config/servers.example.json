{
  "version": 1,
  "servers": {
    "jarvis": {
      "host": "JARVIS_SERVER_PLACEHOLDER",
      "port": 22,
      "user": "jarvis-ops",
      "identity_file": "/etc/jarvis/ssh/example_jarvis_ops_ed25519",
      "host_key_alias": "jarvis-example",
      "enabled": false,
      "projects": {
        "jarvis": {
          "path": "/opt/jarvis",
          "services": [
            "jarvis.service"
          ]
        }
      }
    },
    "crypto": {
      "host": "SERVER_ADDRESS_PLACEHOLDER",
      "port": 22,
      "user": "jarvis-ops",
      "identity_file": "/etc/jarvis/ssh/crypto_ops_ed25519",
      "host_key_alias": "crypto",
      "enabled": false,
      "projects": {
        "crypto-bot": {
          "path": "/opt/crypto-bot",
          "services": [
            "crypto-paper.service",
            "crypto-paper.timer"
          ]
        }
      }
    }
  }
}
