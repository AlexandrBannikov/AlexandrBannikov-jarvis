[Unit]
Description=Jarvis Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
EnvironmentFile=/etc/jarvis/jarvis.env
ExecStart=/opt/jarvis/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jarvis/logs /opt/jarvis/data
ReadOnlyPaths=-/etc/jarvis/hosts.yaml -/etc/jarvis/known_hosts -/etc/jarvis/keys
UMask=0077

[Install]
WantedBy=multi-user.target
